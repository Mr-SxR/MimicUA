{
  "manifest_version": 3,
  "name": "MimicUA - User-Agent Switcher & Device Emulator",
  "short_name": "MimicUA",
  "version": "2.0.0",
  "description": "Professional dual-layer User-Agent switcher. Emulates network headers, navigator properties, and Client Hints API with zero leak.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MimicUA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
